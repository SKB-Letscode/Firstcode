# Environment Configuration for FMF Application
# Copy this file to .env and update with your actual values

# ============================================
# DIRECTORY PATHS
# ============================================
# Base folder where event images and thumbnails are stored
IMAGE_FOLDER=/home/ubuntu/fmf-app/Images

# Database folder location
DB_FOLDER=/home/ubuntu/fmf-app/DB

# ============================================
# AWS S3 CONFIGURATION (Optional)
# ============================================
# Uncomment and configure if you're using S3 for storage

# AWS_ACCESS_KEY_ID=your_access_key_here
# AWS_SECRET_ACCESS_KEY=your_secret_key_here
# AWS_REGION=us-east-1
# S3_BUCKET_NAME=your-bucket-name

# ============================================
# APPLICATION SETTINGS
# ============================================
# Port for the application (default: 8000)
PORT=8000

# ============================================
# OPTIONAL: PRODUCTION SETTINGS
# ============================================
# Uncomment for production deployments

# Log level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
# LOG_LEVEL=INFO

# Workers (for uvicorn - adjust based on CPU cores)
# WORKERS=2

# ============================================
# OPTIONAL: DATABASE SETTINGS
# ============================================
# If you have separate database configurations

# DB_NAME=ImageDB
# DB_USER=ubuntu
# DB_PASSWORD=your_password_here

# ============================================
# NOTES
# ============================================
# 1. Never commit this file with real credentials to git
# 2. Add .env to your .gitignore file
# 3. Use IAM roles instead of access keys when possible
# 4. Restart the service after changing: sudo systemctl restart fmf-app
